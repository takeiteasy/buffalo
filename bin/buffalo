#!/bin/sh
# buffalo -- thin front-end over cccc's comptime pass.
#
# There is no compiled buffalo binary: a spec is lowered to C by running
# cccc over src/buf_comptime.c with the spec path passed as -D BUF_SPEC.
# This script just assembles that invocation.
#
#   buffalo lex   SPEC.bflo [-o OUT.gen.c] [--tokens TOK.h] [-- <extra cccc args>]
#   buffalo parse SPEC.bflo ...              (Phase 2 -- not implemented)
#   buffalo version
#   buffalo help
#
# Honours $CCCC (path to the cccc binary); falls back to `cccc` on PATH.

set -eu

CCCC="${CCCC:-cccc}"
here=$(cd "$(dirname "$0")/.." && pwd)
COMPTIME_SRC="$here/src/buf_comptime.c"
# The pure-C comptime modules. buf_comptime.c pulls their .c bodies in with
# `#include @comptime "buf_*.c"`, so they only need to be on the include path
# (-Isrc below), not the cccc argument list. Compile-time only -- never
# linked into a generated program.
COMPTIME_MODULES="$here/src/buf_rx.c $here/src/buf_tokcheck.c \
$here/src/buf_nfa.c $here/src/buf_dfa.c"

usage() {
    cat <<'EOF'
usage: buffalo <command> [args]

commands:
  lex   SPEC.bflo [-o OUT.gen.c] [--tokens TOK.h] [-- <extra cccc args>]
        Lower a lexer spec to a portable C table file via cccc -c=generated.
        Default output: SPEC.bflo.gen.c
        --tokens overrides the checked-in token header to validate against;
        the default is SPEC with a trailing ".bflo" replaced by "_tokens.h"
        (examples/calc.bflo -> examples/calc_tokens.h).

  parse SPEC.bflo ...
        Parser generator, over the same .bflo file's %grammar section.
        Phase 2 -- not implemented yet.

  version
  help
EOF
}

cmd_lex() {
    [ $# -ge 1 ] || { echo "buffalo lex: missing SPEC.bflo" >&2; exit 2; }
    spec=$1; shift
    out="${spec}.gen.c"
    tokens=""
    extra=""
    while [ $# -gt 0 ]; do
        case $1 in
            -o)       out=$2; shift 2 ;;
            --tokens) tokens=$2; shift 2 ;;
            --)       shift; extra="$*"; break ;;
            *)        echo "buffalo lex: unexpected argument '$1'" >&2; exit 2 ;;
        esac
    done

    if [ ! -f "$spec" ]; then
        echo "buffalo lex: no such spec file: $spec" >&2; exit 2
    fi
    if [ ! -f "$COMPTIME_SRC" ]; then
        echo "buffalo lex: $COMPTIME_SRC does not exist." >&2
        exit 3
    fi
    for m in $COMPTIME_MODULES; do
        [ -f "$m" ] || { echo "buffalo lex: missing module $m" >&2; exit 3; }
    done

    # BUF_STOP_AFTER (M3 ablation ladder) has to be a -D: a source #define is
    # not forwarded into a comptime body. 5 = full pipeline incl. emit. A
    # trailing `-- -D BUF_STOP_AFTER=n [-D BUF_STATS]` overrides it (last -D
    # wins), which is how tests/bench.sh drives the per-phase measurement.
    set -- -c=generated "$COMPTIME_SRC" -Iinclude/buffalo -Isrc -Iruntime \
        -D "BUF_SPEC=\"$spec\"" -D BUF_STOP_AFTER=5
    [ -n "$tokens" ] && set -- "$@" -D "BUF_TOKENS_H=\"$tokens\""
    set -- "$@" -o "$out"

    # shellcheck disable=SC2086
    exec "$CCCC" "$@" $extra
}

cmd_parse() {
    echo "buffalo parse: the parser generator is Phase 2 and is not implemented yet." >&2
    echo "See ROADMAP.md." >&2
    exit 3
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
sub=$1; shift
case $sub in
    lex)             cmd_lex "$@" ;;
    parse)           cmd_parse "$@" ;;
    version|--version) echo "buffalo 0.1.0 (M4 -- lexer generator)" ;;
    help|-h|--help)  usage ;;
    *)               echo "buffalo: unknown command '$sub'" >&2; usage >&2; exit 2 ;;
esac
