#!/bin/sh
# buffalo -- thin front-end over cccc's comptime pass.
#
# There is no compiled buffalo binary: a spec is lowered to C by running
# cccc over src/buf_comptime.c with the spec path passed as -D BUF_SPEC.
# This script just assembles that invocation.
#
#   buffalo lex   SPEC.bflo [-o OUT.gen.c] [--tokens TOK.h] [-- <extra cccc args>]
#   buffalo parse SPEC.bflo [-o OUT.parse.gen.c] [--tokens TOK.h] [-- <extra>]
#   buffalo version
#   buffalo help
#
# Honours $CCCC (path to the cccc binary); falls back to `cccc` on PATH.

set -eu

CCCC="${CCCC:-cccc}"
here=$(cd "$(dirname "$0")/.." && pwd)
COMPTIME_SRC="$here/src/buf_comptime.c"
# buf_comptime.c pulls these in with `#include @comptime "buf_*.c"`, so they
# ride the include path (-Isrc below), not the cccc argument list. Checked
# for existence here only so a missing file gets a buffalo-branded error
# rather than a bare cccc "file not found" from inside the include.
COMPTIME_INCLUDED="$here/src/buf_rx.c $here/src/buf_tokcheck.c \
$here/src/buf_nfa.c $here/src/buf_dfa.c $here/src/buf_grammar.c"

usage() {
    cat <<'EOF'
usage: buffalo <command> [args]

commands:
  lex   SPEC.bflo [-o OUT.gen.c] [--tokens TOK.h] [-- <extra cccc args>]
        Lower a lexer spec to a portable C table file via cccc -c=generated.
        Default output: SPEC.bflo.gen.c
        --tokens overrides the checked-in token header to validate against;
        the default is SPEC with a trailing ".bflo" replaced by "_tokens.h"
        (examples/calc.bflo -> examples/calc_tokens.h).

  parse SPEC.bflo [-o OUT.parse.gen.c] [--tokens TOK.h] [-- <extra cccc args>]
        Lower a lexer + %grammar spec to a portable C table file: the DFA
        tables and buf_next wrapper `lex` emits, plus the LALR(1)
        action/goto/prod tables and the buf_parse_tree wrapper.
        Default output: SPEC.bflo.parse.gen.c
        The spec must carry a %grammar section; --tokens works as for `lex`.

  version
  help
EOF
}

cmd_lex() {
    [ $# -ge 1 ] || { echo "buffalo lex: missing SPEC.bflo" >&2; exit 2; }
    spec=$1; shift
    out="${spec}.gen.c"
    tokens=""
    extra=""
    while [ $# -gt 0 ]; do
        case $1 in
            -o)       out=$2; shift 2 ;;
            --tokens) tokens=$2; shift 2 ;;
            --)       shift; extra="$*"; break ;;
            *)        echo "buffalo lex: unexpected argument '$1'" >&2; exit 2 ;;
        esac
    done

    if [ ! -f "$spec" ]; then
        echo "buffalo lex: no such spec file: $spec" >&2; exit 2
    fi
    if [ ! -f "$COMPTIME_SRC" ]; then
        echo "buffalo lex: $COMPTIME_SRC does not exist." >&2
        exit 3
    fi
    for m in $COMPTIME_INCLUDED; do
        [ -f "$m" ] || { echo "buffalo lex: missing module $m" >&2; exit 3; }
    done

    # BUF_STOP_AFTER (M3 ablation ladder) has to be a -D: a source #define is
    # not forwarded into a comptime body. 5 = full pipeline incl. emit. A
    # trailing `-- -D BUF_STOP_AFTER=n [-D BUF_STATS]` overrides it (last -D
    # wins), which is how tests/bench.sh drives the per-phase measurement.
    set -- -c=generated "$COMPTIME_SRC" -Iinclude/buffalo -Isrc -Iruntime \
        -D "BUF_SPEC=\"$spec\"" -D BUF_STOP_AFTER=5
    [ -n "$tokens" ] && set -- "$@" -D "BUF_TOKENS_H=\"$tokens\""
    set -- "$@" -o "$out"

    # shellcheck disable=SC2086
    exec "$CCCC" "$@" $extra
}

cmd_parse() {
    [ $# -ge 1 ] || { echo "buffalo parse: missing SPEC.bflo" >&2; exit 2; }
    spec=$1; shift
    out="${spec}.parse.gen.c"
    tokens=""
    extra=""
    while [ $# -gt 0 ]; do
        case $1 in
            -o)       out=$2; shift 2 ;;
            --tokens) tokens=$2; shift 2 ;;
            --)       shift; extra="$*"; break ;;
            *)        echo "buffalo parse: unexpected argument '$1'" >&2; exit 2 ;;
        esac
    done

    if [ ! -f "$spec" ]; then
        echo "buffalo parse: no such spec file: $spec" >&2; exit 2
    fi
    if [ ! -f "$COMPTIME_SRC" ]; then
        echo "buffalo parse: $COMPTIME_SRC does not exist." >&2
        exit 3
    fi
    for m in $COMPTIME_INCLUDED; do
        [ -f "$m" ] || { echo "buffalo parse: missing module $m" >&2; exit 3; }
    done

    # -D BUF_EMIT_PARSER turns on the grammar build + parser-table emit;
    # BUF_STOP_AFTER=7 runs the full ladder including those two rungs. Both
    # are -D for the same reason as `lex` (a source #define is not forwarded
    # into a comptime body); a trailing `-- -D ...` still overrides, last wins.
    set -- -c=generated "$COMPTIME_SRC" -Iinclude/buffalo -Isrc -Iruntime \
        -D "BUF_SPEC=\"$spec\"" -D BUF_EMIT_PARSER -D BUF_STOP_AFTER=7
    [ -n "$tokens" ] && set -- "$@" -D "BUF_TOKENS_H=\"$tokens\""
    set -- "$@" -o "$out"

    # shellcheck disable=SC2086
    exec "$CCCC" "$@" $extra
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
sub=$1; shift
case $sub in
    lex)             cmd_lex "$@" ;;
    parse)           cmd_parse "$@" ;;
    version|--version) echo "buffalo 0.1.0 (lexer + LALR(1) parser generator)" ;;
    help|-h|--help)  usage ;;
    *)               echo "buffalo: unknown command '$sub'" >&2; usage >&2; exit 2 ;;
esac
